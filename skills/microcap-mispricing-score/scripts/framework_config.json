{
  "_comment": "Every weight and threshold the scorer uses lives here. Edit this file to tune the framework; the script has no hidden constants except formula definitions. Bands: for lower_better, the first [threshold, points] pair where value <= threshold wins; for higher_better, value >= threshold.",
  "version": "1.0",
  "tax_rate": 0.25,
  "cyclical_history_years": 15,
  "min_history_years_for_percentiles": 5,
  "ocf_normalisation_years": 5,
  "ocf_peak_multiple": 1.5,
  "exclude_lease_liabilities_from_debt": true,
  "default_exit_pe": 20,
  "default_floor_pe": 8,
  "default_floor_pb": 0.7,
  "expense_habit": {
    "min_years": 5,
    "relative_deviation": 0.3,
    "persistent_years": 3,
    "peer_low_ratio": 0.5,
    "peer_high_ratio": 1.5
  },
  "kill_switches": {
    "flags": [
      "revenue_inflation_found",
      "auditor_linked_to_fraud_companies",
      "merchant_banker_regulatory_action",
      "plant_claims_contradicted_on_visit",
      "operator_or_fake_volumes_suspected"
    ],
    "lavish_spend_pct_of_mcap": 15,
    "score_cap": 20,
    "vanity_spend_recent_years": 5
  },
  "verdict_bands": [
    [
      75,
      "STRONG CANDIDATE - worth a full deep-dive"
    ],
    [
      60,
      "WATCHLIST - promising, verify the open questions"
    ],
    [
      45,
      "MONITOR - some merit, thesis not yet there"
    ],
    [
      0,
      "PASS - framework does not support it today"
    ]
  ],
  "min_coverage_warning": 0.7,
  "classification": {
    "cheap_valuation_pct": 60,
    "change_growth_pct": 50,
    "garp_peg_max": 1.0
  },
  "valuation_rules": {
    "cyclical": [
      {
        "metric": "cyclically_adjusted_pe",
        "label": "Cyclically adjusted P/E (single digit is the target)",
        "direction": "lower_better",
        "bands": [
          [
            10,
            10
          ],
          [
            15,
            6
          ],
          [
            20,
            3
          ]
        ],
        "max": 10
      },
      {
        "metric": "pctile_ev_sales",
        "label": "EV/Sales percentile vs own history",
        "direction": "lower_better",
        "bands": [
          [
            25,
            8
          ],
          [
            50,
            4
          ]
        ],
        "max": 8
      },
      {
        "metric": "implied_pe_from_book",
        "label": "Implied P/E = P/B / normalised ROE",
        "direction": "lower_better",
        "bands": [
          [
            7,
            7
          ],
          [
            10,
            4
          ],
          [
            15,
            2
          ]
        ],
        "max": 7
      }
    ],
    "stable": [
      {
        "metric": "pctile_pe",
        "label": "Adjusted P/E percentile vs own history",
        "direction": "lower_better",
        "bands": [
          [
            25,
            10
          ],
          [
            50,
            5
          ]
        ],
        "max": 10
      },
      {
        "metric": "pctile_ev_ebitda",
        "label": "EV/EBITDA percentile vs own history",
        "direction": "lower_better",
        "bands": [
          [
            25,
            8
          ],
          [
            50,
            4
          ]
        ],
        "max": 8
      },
      {
        "metric": "ev_ocf_normalised",
        "label": "EV / 5-yr average OCF",
        "direction": "lower_better",
        "bands": [
          [
            15,
            7
          ],
          [
            25,
            3
          ]
        ],
        "max": 7
      }
    ],
    "growth": [
      {
        "metric": "peg",
        "label": "PEG ratio",
        "direction": "lower_better",
        "bands": [
          [
            0.75,
            10
          ],
          [
            1.0,
