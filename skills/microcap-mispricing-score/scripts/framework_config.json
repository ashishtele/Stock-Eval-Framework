          [
            3,
            4
          ],
          [
            2,
            3
          ],
          [
            1.5,
            1
          ]
        ],
        "max": 4
      },
      {
        "metric": "downside_pct",
        "label": "Downside to floor value (%)",
        "direction": "lower_better",
        "bands": [
          [
            20,
            3
          ],
          [
            35,
            2
          ],
          [
            50,
            1
          ]
        ],
        "max": 3
      },
      {
        "metric": "optionality",
        "label": "Optionality (free if base business protects value)",
        "type": "category",
        "map": {
          "protected": 2,
          "unprotected": 1,
          "none": 0
        },
        "max": 2
      },
      {
        "metric": "ai_disruption_risk",
        "label": "AI disruption risk",
        "type": "category",
        "map": {
          "low": 1,
          "medium": 0,
          "high": 0
        },
        "max": 1
      }
    ],
    "governance_and_history": [
      {
        "metric": "years_listed",
        "label": "Years listed (history to verify promises)",
