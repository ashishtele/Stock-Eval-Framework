          ]
        ],
        "max": 10
      },
      {
        "metric": "forward_pe",
        "label": "Forward P/E",
        "direction": "lower_better",
        "bands": [
          [
            15,
            8
          ],
          [
            25,
            5
          ],
          [
            35,
            2
          ]
        ],
        "max": 8
      },
      {
        "metric": "ev_ocf_normalised",
        "label": "EV / 5-yr average OCF",
        "direction": "lower_better",
        "bands": [
          [
            25,
            7
          ],
          [
            40,
            3
          ]
        ],
        "max": 7
      }
    ],
    "capex_transition": [
      {
        "metric": "forward_pe",
        "label": "Forward P/E (trailing P/E ignored: upfront capex costs distort it)",
