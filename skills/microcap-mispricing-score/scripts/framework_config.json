        "label": "EV/Sales percentile vs own history",
        "direction": "lower_better",
        "bands": [
          [
            50,
            8
          ],
          [
            75,
            4
          ]
        ],
        "max": 8
      },
      {
        "metric": "peg",
        "label": "PEG ratio",
        "direction": "lower_better",
        "bands": [
          [
            1.0,
            7
          ],
          [
            1.5,
            3
          ]
        ],
        "max": 7
      }
    ],
    "new_age": [
      {
        "metric": "forward_pe",
        "label": "Forward P/E on your 2-3 yr PAT assumption",
        "direction": "lower_better",
        "bands": [
          [
            25,
            12
          ],
          [
            40,
            6
          ],
          [
            60,
            2
          ]
        ],
        "max": 12
      },
      {
        "metric": "peg",
        "label": "PEG ratio",
        "direction": "lower_better",
        "bands": [
          [
            1.0,
            13
          ],
          [
            1.5,
            6
          ]
        ],
        "max": 13
      }
