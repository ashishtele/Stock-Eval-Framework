        "bands": [
          [
            10,
            3
          ],
          [
            5,
            2
          ]
        ],
        "max": 3
      },
      {
        "metric": "guidance_track_record",
        "label": "Management delivered past guidance / AR narrative",
        "type": "category",
        "map": {
          "good": 4,
          "mixed": 2,
          "poor": 0
