    "growth_and_earnings_gap": [
      {
        "metric": "earnings_gap_pp",
        "label": "Earnings gap: forward PAT CAGR minus past 3-yr PAT CAGR (pp)",
        "direction": "higher_better",
        "bands": [
          [
            10,
            6
          ],
          [
            0,
            3
          ]
        ],
        "max": 6
      },
      {
        "metric": "forward_pat_cagr_pct",
        "label": "Forward PAT CAGR (%)",
        "direction": "higher_better",
        "bands": [
          [
            25,
            4
          ],
          [
            15,
            3
          ],
          [
            10,
            1
          ]
        ],
        "max": 4
      },
      {
        "metric": "change_identified",
        "label": "Specific industry/company change identified",
        "type": "bool",
        "true_points": 3,
        "false_points": 0,
        "max": 3
      },
      {
        "metric": "new_product_share_gain_pp",
        "label": "New-product share of sales gained (pp, ~3 yrs)",
        "direction": "higher_better",
        "bands": [
          [
            10,
            2
          ],
          [
            5,
            1
          ]
        ],
        "max": 2
      }
    ],
    "cycle_and_sentiment": [
      {
        "metric": "sector_underperformed_10y",
        "label": "Sector underperformed broad index over ~10 yrs",
        "type": "bool",
        "true_points": 3,
        "false_points": 0,
        "max": 3
      },
      {
        "metric": "capital_exiting_sector",
        "label": "Capital exiting / weak players shutting (capital cycle)",
        "type": "bool",
        "true_points": 3,
        "false_points": 0,
        "max": 3
      },
      {
        "metric": "drawdown_from_3y_high_pct",
        "label": "Drawdown from 3-yr high (%)",
        "direction": "higher_better",
        "bands": [
          [
            40,
            2
          ],
          [
            25,
            1
          ]
        ],
        "max": 2
      },
      {
        "metric": "seller_concern",
        "label": "Why sellers are selling",
        "type": "category",
        "map": {
          "cyclical": 2,
          "temporary": 2,
          "neglected": 2,
          "growth": 1,
          "management": 0,
          "structural": 0
        },
        "max": 2
      }
    ],
    "asymmetry_and_optionality": [
      {
        "metric": "upside_multiple",
        "label": "Upside: forward PAT x exit P/E / market cap",
