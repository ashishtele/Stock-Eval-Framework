  "pillars": {
    "earnings_quality": [
      {
        "metric": "ocf_ebitda_conversion_5y",
        "label": "OCF / EBITDA conversion (5 yr)",
        "direction": "higher_better",
        "bands": [
          [
            0.8,
            6
          ],
          [
            0.6,
            4
          ],
          [
            0.4,
            2
          ]
        ],
        "max": 6
      },
      {
        "metric": "receivables_minus_sales_growth_pp",
        "label": "Receivables growth minus sales growth (pp, last yr)",
        "direction": "lower_better",
        "bands": [
          [
            0,
            4
          ],
          [
            5,
            2
          ]
        ],
        "max": 4
      },
      {
        "metric": "expense_flag_count",
        "label": "Expense anomalies (margin-boosting cuts / peer outliers)",
        "direction": "lower_better",
        "bands": [
          [
            0,
            3
          ],
          [
            1,
            1
          ]
        ],
        "max": 3
      },
      {
        "metric": "ocf_at_peak",
        "label": "Current OCF not an abnormal peak",
        "type": "bool",
        "true_points": 0,
        "false_points": 2,
        "max": 2
      }
    ],
    "balance_sheet": [
      {
        "metric": "net_debt_to_ebitda",
        "label": "Net debt / normalised EBITDA",
        "direction": "lower_better",
        "bands": [
          [
            0,
            4
          ],
          [
            1,
            3
          ],
          [
            2.5,
            1
          ]
        ],
        "max": 4
      },
      {
        "metric": "debt_change_3y_pct",
        "label": "Debt change over 3 yrs (%)",
        "direction": "lower_better",
        "bands": [
          [
            0,
            3
          ],
          [
            10,
            1
          ]
        ],
        "max": 3
      },
      {
        "metric": "roe_normalised",
        "label": "Normalised ROE (%)",
