{
  "version": "0.1.0",
  "updated_at": "2026-10-22",
  "frameworks": ["ameya-peak-pessimism"],
  "scoring": {
    "composite": "equal_weight_mean",
    "range": [0, 100],
    "higher_means": "more consistent with the peak-pessimism thesis",
    "weight_basis": "derived_equal",
    "creator_stated": false,
    "coverage_gate": 0.7,
    "notes": "Derived index. Equal weights are ours, not the creator's. The row table is the primary output; the composite is a ranking aid and never a buy signal."
  },
  "metrics": [
    {
      "id": "sector_breadth",
      "criterion_id": "sector-in-pain",
      "name": "Share of sector peers with current OPM below their own multi-year median",
      "formula": "count(peer.ttm_opm < median(peer.annual_opm, up to 5y)) / count(peers_with_data)",
      "inputs": ["peer.ttm_opm", "peer.annual_opm"],
      "unit": "ratio",
      "direction": "higher_is_more_pain",
      "anchors": [{"value": 0.0, "score": 0}, {"value": 1.0, "score": 100}],
      "basis": "proxy",
      "adapter": "screener_peers",
      "confidence": "medium",
      "note": "Breadth is a proxy for industry-wide pain; it does not measure capacity utilisation directly."
    },
    {
      "id": "multiple_ratio",
      "criterion_id": "multiple-collapse",
      "name": "Current P/B divided by P/B at the price peak",
      "formula": "(P_t / BVPS_published_at_t) / (P_peak / BVPS_published_at_peak)",
      "inputs": ["price.adjusted_close", "balance_sheet.book_value", "price.peak_date"],
      "unit": "ratio",
      "direction": "lower_is_more_collapse",
      "anchors": [{"value": 1.0, "score": 0}, {"value": 0.5, "score": 100}],
      "basis": "creator_stated",
      "adapter": "screener_prices",
      "confidence": "medium",
      "note": "Uses the annual book value that was public on each date, so the peak multiple has no lookahead."
    },
    {
      "id": "price_drawdown",
      "criterion_id": "price-drawdown",
      "name": "Drawdown from the highest adjusted close in the lookback window",
      "formula": "1 - P_t / max(P over 5y)",
      "inputs": ["price.adjusted_close"],
      "unit": "ratio",
      "direction": "higher_is_more_pessimism",
      "anchors": [{"value": 0.0, "score": 0}, {"value": 0.5, "score": 100}],
      "basis": "creator_stated",
      "adapter": "prices",
      "confidence": "high",
      "note": "The creator's stated screen is >= 50%."
    },
    {
      "id": "call_brevity",
      "criterion_id": "earnings-call-brevity",
      "name": "Latest earnings-call duration versus the trailing median",
      "formula": "clamp(1 - duration_t / median(last 8 durations), 0, 1)",
      "inputs": ["earnings_call.duration"],
      "unit": "ratio",
      "direction": "higher_is_more_neglect",
      "anchors": [{"value": 0.0, "score": 0}, {"value": 0.4, "score": 100}],
      "basis": "creator_stated",
      "adapter": "concall",
      "available": false,
      "reason": "No concall audio/transcript adapter yet.",
      "confidence": "high"
    },
    {
      "id": "coverage_delta",
      "criterion_id": "coverage-and-chatter-decline",
      "name": "Change in institutional holdings over four quarters (proxy for coverage exit)",
      "formula": "(DII + FII)_t - (DII + FII)_(t-4q)",
      "inputs": ["shareholding.dii", "shareholding.fii"],
      "unit": "percentage_points",
      "direction": "lower_is_more_neglect",
      "anchors": [{"value": 0.0, "score": 0}, {"value": -5.0, "score": 100}],
      "basis": "proxy",
      "adapter": "screener",
      "confidence": "low",
      "note": "Institutional exit is not the same as sell-side coverage. Label as a proxy."
    },
    {
      "id": "capacity_exit",
      "criterion_id": "capacity-exit",
      "name": "Industry capacity exit / new-capacity economics",
      "formula": "share of announced capacity additions deemed uneconomic at current spreads",
      "inputs": ["industry.capacity_announcements", "industry.spreads"],
      "unit": "ratio",
      "direction": "higher_is_more_exit",
      "anchors": [{"value": 0.0, "score": 0}, {"value": 1.0, "score": 100}],
      "basis": "creator_stated",
      "adapter": "industry",
      "available": false,
      "reason": "No industry capacity/spread dataset yet.",
      "confidence": "medium"
    },
    {
      "id": "promoter_delta",
      "criterion_id": "promoter-buying",
      "name": "Change in promoter shareholding over four quarters",
      "formula": "promoter_pct_t - promoter_pct_(t-4q)",
      "inputs": ["shareholding.promoter"],
      "unit": "percentage_points",
      "direction": "higher_is_more_buying",
      "anchors": [{"value": 0.0, "score": 0}, {"value": 5.0, "score": 100}],
      "basis": "proxy",
      "adapter": "screener",
      "confidence": "low",
      "note": "Percentage change cannot distinguish open-market purchase from preferential allotment. Needs NSE/BSE insider filings."
    },
    {
      "id": "mgmt_analyst_gap",
      "criterion_id": "management-bullish-analysts-skeptical",
      "name": "Management guidance revision minus consensus EPS revision",
      "formula": "guidance_revision - consensus_eps_revision",
      "inputs": ["earnings_call.guidance", "coverage.consensus_eps"],
      "unit": "percentage_points",
      "direction": "higher_is_more_divergence",
      "anchors": [{"value": 0.0, "score": 0}, {"value": 10.0, "score": 100}],
      "basis": "creator_stated",
      "adapter": "consensus",
      "available": false,
      "reason": "No consensus estimates adapter yet.",
      "confidence": "medium"
    },
    {
      "id": "shock_type",
      "criterion_id": "shock-type-identified",
      "name": "Supply versus demand classification of the recovery",
      "formula": "classify(supply_events, demand_drivers): supply-only=100, both=100, demand-only=50, neither=0",
      "inputs": ["industry.supply_events", "industry.demand_drivers"],
      "unit": "score",
      "direction": "higher_is_supply_solved",
      "anchors": [{"value": 0, "score": 0}, {"value": 100, "score": 100}],
      "basis": "creator_stated",
      "adapter": "industry",
      "available": false,
      "reason": "Classification needs industry event data; not automated yet.",
      "confidence": "medium"
    },
    {
      "id": "visibility_12q",
      "criterion_id": "twelve-quarter-visibility",
      "name": "Forward visibility in quarters from order book and capacity pipeline",
      "formula": "min(order_book / TTM_revenue, capacity_pipeline_quarters)",
      "inputs": ["industry.order_book", "industry.capacity_pipeline"],
      "unit": "quarters",
      "direction": "higher_is_more_visibility",
      "anchors": [{"value": 0, "score": 0}, {"value": 12, "score": 100}],
      "basis": "creator_stated",
      "adapter": "filings",
      "available": false,
      "reason": "No order-book/capacity-pipeline adapter yet.",
      "confidence": "medium"
    },
    {
      "id": "relative_margin_gap",
      "criterion_id": "worst-company-best-affected",
      "name": "Peer median OPM minus company OPM (higher gap = more operating leverage to recover)",
      "formula": "median(peer.ttm_opm) - company.ttm_opm",
      "inputs": ["company.ttm_opm", "peer.ttm_opm"],
      "unit": "percentage_points",
      "direction": "higher_is_more_delta",
      "anchors": [{"value": 0.0, "score": 0}, {"value": 5.0, "score": 100}],
      "basis": "proxy",
      "adapter": "screener_peers",
      "confidence": "low",
      "note": "Margin gap is a proxy for earnings delta, not a direct measure of operating leverage."
    },
    {
      "id": "viability",
      "criterion_id": "structural-viability",
      "name": "Balance-sheet and cash-flow viability through the trough",
      "formula": "100 * min(clamp(interest_cover/3,0,1), clamp((2-debt_to_equity)/2,0,1)) * (0.5 if CFO<=0 else 1)",
      "inputs": ["income.operating_profit", "income.interest", "balance_sheet.borrowings", "balance_sheet.equity", "cash_flow.cfo"],
      "unit": "score",
      "direction": "higher_is_more_viable",
      "anchors": [{"value": 0, "score": 0}, {"value": 100, "score": 100}],
      "basis": "derived",
      "adapter": "screener",
      "confidence": "medium",
      "note": "Disqualifying criterion. A score below 40 sets disqualified=true."
    }
  ]
}
